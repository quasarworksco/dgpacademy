rules_version = '2';

// DGP Academy — reglas de Firestore
// Publícalas en Firebase Console → Firestore Database → Reglas (o con `firebase deploy --only firestore:rules`).
//
// Modelo de permisos:
//  · Cada estudiante solo puede leer y escribir SU propio documento users/{uid}.
//  · Los campos que dan acceso o registran pagos (courses, books, payments) solo los cambia el admin.
//  · El admin (ADMIN_UID) puede leer y editar a todos los usuarios y la configuración.
//  · config/cupos es público para que la landing muestre los cupos disponibles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'xbrwtQPEmdPXUOqYabkZQPWG32C3';
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function grantsAccess() {
      return ['courses', 'books', 'payments'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(uid) && !request.resource.data.keys().hasAny(grantsAccess()));
      allow update: if isAdmin()
        || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(grantsAccess()));
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
